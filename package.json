{
  "name": "decker-ts",
  "version": "0.0.1",
  "description": "Remaster hry Decker 1.12 (Shawn Overcash, 2001) v TypeScriptu pro prohlížeč",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "assets": "python3 tools/convert_assets.py ../DeckerSource assets"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
